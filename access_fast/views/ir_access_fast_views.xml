<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="ir_access_fast_form_view">
        <field name="name">ir.access.fast.form</field>
        <field name="model">ir.access.fast</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="model_id" />
                        <field name="field_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="ir_access_fast_tree_view">
        <field name="name">ir.access.fast.tree</field>
        <field name="model">ir.access.fast</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="model_id" />
                <field name="field_id" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_access_fast">
        <field name="name">Access Fast</field>
        <field name="res_model">ir.access.fast</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="menu_access_fast">
        <field name="name">Access Fast</field>
        <field name="parent_id" ref="base.next_id_9" />
        <field name="action" ref="action_access_fast" />
        <field name="sequence" eval="90" />
    </record>

</odoo>
