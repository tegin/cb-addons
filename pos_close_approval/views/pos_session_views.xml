<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_session_form" model="ir.ui.view">
        <field name="name">pos.session.form.view</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_inline oe_link"
                    name="%(pos_cash_box_act_window)d"
                    type="action"
                    groups="point_of_sale.group_pos_manager"
                    attrs="{'invisible' : [('state', '=', 'closed')]}"
                >Cash In/Out</button>
            </div>
            <button name="action_pos_session_closing_control" position="after">
                <button
                    name="action_pos_session_approve"
                    type="object"
                    string="Approve"
                    class="oe_highlight"
                    attrs="{'invisible': ['|','|', ('requires_approval', '=', False), ('state', '!=', 'closing_control'), ('rescue', '=', False)]}"
                    groups="point_of_sale.group_pos_manager"
                />
                <field name="requires_approval" invisible="1" />
            </button>
            <sheet position="inside">
                <notebook>
                    <page
                        name="no_cash_control"
                        string="Cash Control"
                        attrs="{'invisible' : [('requires_approval', '=', False)]}"
                    >
                        <group>
                            <field
                                style="text-align:right;margin:0;padding:0;"
                                name="cash_register_balance_start"
                                readonly="1"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                string="Starting Cash"
                            />
                            <field
                                style="text-align:right;margin:0;padding:0;"
                                name="cash_register_total_entry_encoding"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                string="+ Transactions"
                            />
                            <field
                                style="text-align:right;margin:0;padding:0;"
                                name="cash_register_balance_end"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                string="= Expected in Cash"
                            />
                        </group>
                    </page>
                    <page
                        string="Statements"
                        name="statements"
                        attrs="{'invisible' : [('requires_approval', '=', False)]}"
                        groups="point_of_sale.group_pos_manager"
                    >
                        <field name="statement_line_ids">
                            <form>
                                <group>
                                    <field name="journal_id" />
                                    <field name="state" invisible="1" />
                                    <field name="account_id" />
                                    <field name="pos_session_state" invisible="1" />
                                    <field name="payment_ref" />
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="amount" />
                                </group>
                            </form>
                            <tree>
                                <field name="journal_id" />
                                <field name="state" invisible="1" />
                                <field name="account_id" />
                                <button
                                    name="%(action_statement_change_account)d"
                                    type="action"
                                    string="Change account"
                                    class="oe_highlight"
                                    attrs="{'invisible':['|', ('pos_session_state', '!=', 'closing_control'), ('account_id', '=', False)]}"
                                />
                                <field name="pos_session_state" invisible="1" />
                                <field name="payment_ref" />
                                <field name="name" />
                                <field name="partner_id" />
                                <field name="amount" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>
</odoo>
